# Linear Regression from Scratch (NumPy)
Implementation pf linear regression using vectorized NumPy operations: 
- Forward pass
- MSE loss
- Gradients
- Gradient descent

import numpy as np

# synthetic data
np.random.seed(0)
X = 2 * np.random.rand(100, 1)
y = 4 + 3 * X[:, 0] + np.random.randn(100)

# helper functions

def predict(X, W, b): 
    return X @ W + b

def MSE(y_hat, y): 
    return np.mean((y_hat - y) ** 2)

# training function

def linearRegression(X, y, lr=0.01, epochs=1000): 
    n_samples, n_features = X.shape

    W = np.zeros(n_features)
    b = 0.0

    for epoch in range(epochs): 
        y_hat = predict(X, W, b)
        loss = MSE(y_hat, y)

        grad_w = (-2/n_samples) * (X.T @ (y - y_hat))
        grad_b = (-2/n_samples) * np.sum(y - y_hat)

        w -= lr * grad_w
        b -= lr * grad_b
   return w, b
        


